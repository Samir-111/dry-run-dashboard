BLYNK_TOKEN=your_device_auth_token_here
BLYNK_REGION=blr1
RELAY_PIN=V0
PORT=3001

# Optional — for push notifications (the alert system).
# If omitted, the server auto-generates temporary keys on every restart
# (console will print them). Copy those into your real .env to keep
# existing push subscriptions working across restarts instead of having
# every farmer re-enable notifications each time the server restarts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Twilio cloud fallback (fires only if the SIM800L doesn't confirm) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
GSM_CONFIRM_TIMEOUT_MS=45000
